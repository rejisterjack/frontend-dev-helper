{
  "$schema": "https://json.schemastore.org/lint-staged",
  "apps/web/**/*.{ts,tsx}": [
    "prettier --write",
    "eslint --fix --max-warnings=0"
  ],
  "apps/ext/**/*.{ts,tsx}": [
    "prettier --write",
    "eslint --fix --max-warnings=0"
  ],
  "*.{ts,tsx,cts,mts,cjs,mjs,js,jsx}": ["prettier --write"],
  "*.{json,md,yml,yaml,css,scss,html}": ["prettier --write"]
}
