{
  "name": "fdh-vsx",
  "displayName": "Frontend Dev Helper Bridge",
  "description": "Bridge between FDH browser extension and VS Code. Jump to source, apply fixes, and sync element selection.",
  "version": "0.0.1",
  "publisher": "fdh",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [],
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fdh.restartServer",
        "title": "FDH: Restart Bridge Server"
      },
      {
        "command": "fdh.showStatus",
        "title": "FDH: Show Connection Status"
      },
      {
        "command": "fdh.showBridgeToken",
        "title": "FDH: Copy Bridge Auth Token"
      }
    ],
    "configuration": {
      "title": "FDH Bridge",
      "properties": {
        "fdh.port": {
          "type": "number",
          "default": 9456,
          "description": "WebSocket port for FDH browser bridge"
        },
        "fdh.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start bridge server when VS Code opens"
        },
        "fdh.sourceMapPathOverrides": {
          "type": "object",
          "default": {
            "webpack:///./src/": "src/",
            "webpack:///./": "./"
          },
          "description": "Maps source map paths to workspace paths. Keys are prefixes to match, values are replacements. Similar to Chrome DevTools path overrides.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "dev": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch": "bun run watch:esbuild & bun run watch:tsc",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@repo/bridge-protocol": "workspace:*",
    "ws": "^8.20.1"
  }
}
