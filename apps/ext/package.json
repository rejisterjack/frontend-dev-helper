{
  "name": "frontend-dev-helper",
  "version": "1.0.0",
  "description": "A comprehensive frontend debugging toolkit browser extension with 40+ tools for inspection, CSS analysis, performance profiling, accessibility auditing, and AI-powered analysis.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "FrontendDevHelper Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/rejisterjack/frontend-dev-helper.git"
  },
  "homepage": "https://github.com/rejisterjack/frontend-dev-helper",
  "bugs": {
    "url": "https://github.com/rejisterjack/frontend-dev-helper/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "frontend",
    "developer-tools",
    "debugging",
    "manifest-v3",
    "css",
    "accessibility",
    "performance",
    "react",
    "shadcn-ui",
    "wxt"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "axe-core": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.7.0",
    "source-map": "^0.7.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "wxt": "^0.20.26"
  }
}
