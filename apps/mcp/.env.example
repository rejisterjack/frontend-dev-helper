# =============================================================================
# apps/mcp — Environment variables
# =============================================================================
# This is a vendored copy of Google's `chrome-devtools-mcp` server. Env vars
# below are inherited from upstream; see apps/mcp/README.md for the canonical
# reference. The CLI also accepts equivalent flags (see `--help`).
#
# Most users invoke the server via an MCP client (Cursor/Claude) and never
# need to set any of these — defaults are correct for local use.

# ---- Telemetry (OPTIONAL) ----------------------------------------------------
# Set to "true" to DISABLE Google usage-statistics collection. Default is on;
# see apps/mcp/SECURITY.md for what's sent.
# CHROME_DEVTOOLS_MCP_DISABLE_USAGE_STATISTICS=

# ---- Isolated context (OPTIONAL) --------------------------------------------
# Internal session id used by the daemon for socket isolation.
# CHROME_DEVTOOLS_MCP_SESSION_ID=

# ---- Standard env (read by Node and the OS, not the app) --------------------
# XDG_RUNTIME_DIR — used on Linux/BSD for the daemon socket path. Usually set
#                   by the OS session manager; no action needed.
