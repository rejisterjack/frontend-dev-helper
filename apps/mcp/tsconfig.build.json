  "compilerOptions": {
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noImplicitReturns": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "strict": false
  },
  "exclude": [
    "tests/**/*",
    "node_modules/chrome-devtools-frontend/**/*.test.ts"
  ]
}
