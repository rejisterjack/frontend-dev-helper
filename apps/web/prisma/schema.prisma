// Prisma v7 generator — the Rust-free `prisma-client`. The `output` field
// is REQUIRED in v7; the client is no longer generated into node_modules.
// Output path is relative to this schema file, so we generate into
// apps/web/prisma/generated/client (gitignored — see .gitignore).
//
// ID strategy: this schema uses `@default(uuid())` for all primary keys. The
// workspace Prisma rule prescribes `@default(cuid())` for string IDs, but
// switching would require a destructive migration (existing UUIDs are not
// valid cuids and would have to be regenerated, breaking every FK in the
// database). We deliberately keep `uuid()` and document the deviation here.
generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

// Datasource: provider only. The connection URL is wired in prisma.config.ts
// (Prisma v7 convention). We use the @prisma/adapter-neon driver adapter at
// runtime — see lib/db.ts. No `directUrl` is required: Neon's pooler URL in
// DATABASE_URL handles both pooling (queries) and DDL (migrations) fine.
datasource db {
  provider = "postgresql"
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String?
  name             String?
  emailVerified    Boolean   @default(false)
  oauthProvider    String?
  oauthId          String?
  avatarUrl        String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  deletedAt        DateTime?
  referredById     String?
  referredBy       Referral? @relation("Referred")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  emailVerifications EmailVerification[]
  referrals          Referral[]          @relation("Referrer")

  @@unique([oauthProvider, oauthId])
  @@index([referredById])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Referral {
  id           String         @id @default(uuid())
  referrerId   String
  referrer     User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referralCode String         @unique
  referredId   String?        @unique
  referred     User?          @relation("Referred", fields: [referredId], references: [id], onDelete: SetNull)
  reward       String?
  status       ReferralStatus @default(PENDING)
  redeemedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([referrerId])
}
