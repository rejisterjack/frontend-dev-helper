# =============================================================================
# apps/web — Environment variables
# =============================================================================
# Copy to `.env` (gitignored) and fill in real values:
#
#   cp apps/web/.env.example apps/web/.env
#
# For Vercel / CI, set these as project environment variables. Variables marked
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.
#
# Generated by Phase 0.7 of the Production Readiness Audit.

# ---- Database (REQUIRED) -----------------------------------------------------
# Neon Postgres connection string. This is the ONLY URL needed — Neon's
# pooler handles both runtime queries (pooled) and DDL/migrations.
# Get it from your Neon project dashboard → "Connection string" → "-pooler".
# Requires sslmode=require (Neon enforces TLS).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---- Auth (REQUIRED) ---------------------------------------------------------
# Used to sign JWTs. Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET="generate-a-32+-char-random-string"
# Canonical URL of the deployed app. Used for email links and OAuth redirects.
NEXTAUTH_URL="http://localhost:7393"

# ---- OAuth providers (set whichever you enable) ------------------------------
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- Email (REQUIRED for email-verify / password-reset) ----------------------
# Resend.com API key. Create at https://resend.com/api-keys
RESEND_API_KEY=""

# ---- Rate limiting (OPTIONAL but recommended in production) ------------------
# When both are set, the app uses Upstash Redis for distributed rate limiting.
# When unset, an in-memory limiter is used (single-instance only).
# Create at https://console.upstash.com/ (REST API, not the regular Redis URL).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Error monitoring (OPTIONAL) --------------------------------------------
# Set to enable Sentry. Without it, the app runs but doesn't report errors.
NEXT_PUBLIC_SENTRY_DSN=""
# Source map upload (CI only):
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- Logging (OPTIONAL) ------------------------------------------------------
# winston level: 'error' | 'warn' | 'info' | 'debug'
LOG_LEVEL="info"
