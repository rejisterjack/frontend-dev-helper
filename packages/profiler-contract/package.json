{
  "name": "@repo/profiler-contract",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Single source of truth for the React Profiler data contract. Shared between the browser extension, the analysis worker, and (in the future) any web/CI consumer.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}
